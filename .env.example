# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
DATABASE_URL=postgres://mariox:mariox_dev_password@localhost:5433/mariox_portal
TEST_DATABASE_URL=postgres://mariox:mariox_dev_password@localhost:5433/mariox_portal_test
DB_POOL_MAX=10

# ---- Auth ----
# Use long random strings in production: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=10

# ---- File storage (uploads: lead / project / bug / change-request documents) ----
# s3    = AWS S3 or any S3-compatible store (production)
# local = files on disk under UPLOAD_DIR (only for quick runs; the test suite uses it automatically)
STORAGE_DRIVER=s3
S3_BUCKET=mariox-portal-documents
S3_REGION=ap-south-1
# AWS: leave S3_ENDPOINT / keys empty and give the server an IAM role (or env/profile credentials)
#      with s3:PutObject, s3:GetObject, s3:DeleteObject, s3:ListBucket on the bucket.
# Local MinIO (`npm run storage:up`): endpoint + path-style + the MinIO user/password from docker-compose.yml
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=mariox
S3_SECRET_ACCESS_KEY=mariox_dev_password
# Create the bucket on startup if it doesn't exist (local MinIO convenience — keep false on AWS)
S3_CREATE_BUCKET=true
# Optional key prefix inside the bucket, e.g. portal/
S3_PREFIX=
# Encryption at rest: AES256 (S3-managed), aws:kms (+ S3_KMS_KEY_ID) or none (MinIO without KMS)
S3_SSE=none
# Downloads: proxy = stream through the API (default, no bucket CORS needed)
#            redirect = 302 to a short-lived presigned URL (needs bucket CORS for the web origin)
S3_DOWNLOAD_MODE=proxy
S3_PRESIGN_TTL_SECONDS=300
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ---- Logging ----
LOG_LEVEL=info

# ---- Time ----
# IANA time zone for working days (check-in, late after 10:30, timesheet days)
APP_TZ=Asia/Kolkata

# First Super Admin, created by `npm run seed` (only if no Super Admin exists yet).
# Leave the password empty to generate a random one (printed once by the seed).
SUPER_ADMIN_NAME=CEO
SUPER_ADMIN_EMAIL=ceo@marioxsoftware.com
SUPER_ADMIN_PASSWORD=

# Email (SMTP). Invites / password resets are emailed when SMTP_USER + SMTP_PASS are set;
# otherwise the admin gets a one-time link to share. Google Workspace: smtp.gmail.com:587 with an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=Mariox Software
# Frontend URL used in email links (production: your portal domain)
APP_URL=http://localhost:5173
